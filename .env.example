# Copy this file to .env and replace every placeholder locally.
# Never commit .env or share its values in chat, screenshots, or GitHub.

# -----------------------------------------------------------------------------
# Dashboard publishing (Upstash Redis / Vercel KV)
# Required when the live monitor should update aura.lightninglogics.me.
# -----------------------------------------------------------------------------
KV_REST_API_URL=https://your-upstash-endpoint.upstash.io
KV_REST_API_TOKEN=replace_with_your_upstash_write_token
# Required only for the protected serverless /api/poll endpoint. Use a long random value.
POLL_SECRET=replace_with_a_long_random_secret

# -----------------------------------------------------------------------------
# Angel One SmartAPI -- live market-data monitor only
# Create these in your Angel One/SmartAPI account. Do NOT use order APIs.
# -----------------------------------------------------------------------------
ANGEL_API_KEY=replace_with_your_smartapi_key
ANGEL_CLIENT_CODE=replace_with_your_angel_one_client_code
ANGEL_PIN=replace_with_your_angel_one_pin
ANGEL_TOTP_SECRET=replace_with_your_totp_secret

# -----------------------------------------------------------------------------
# AuRA live-monitor safeguards
# Keep the current MCX browser monitor by default. Set this to "angelone" only
# after adding valid SmartAPI credentials above.
# -----------------------------------------------------------------------------
LIVE_SOURCE=mcx
MONITOR_ONLY=true
ANGEL_MCX_EXCHANGE_TYPE=5
ANGEL_PRICE_DIVISOR=100
ANGEL_PUBLISH_SECONDS=2
# Serverless mode uses a one-shot REST quote every 15 minutes, not a WebSocket stream.
SERVERLESS_POLL_SECONDS=900
# A snapshot older than this is never shown as globally live by the API/frontend.
LIVE_FRESH_SECONDS=45
# Optional JSON override when Angel One instrument-master matching needs help.
# All five keys are required, for example:
# ANGEL_MCX_TOKENS_JSON={"ten":"123","ten_next":"124","petal":"125","guinea":"126","m":"127"}
